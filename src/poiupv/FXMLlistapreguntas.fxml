            <Button fx:id="aleatoria" onAction="#handlepreguntaaleatoria" styleClass="mostar" stylesheets="@../resources/menu%20estilos.css" text="Pregunta Aleatoria" />
            <Button fx:id="botonmenu" onAction="#salirmenu" styleClass="mostar" stylesheets="@../resources/menu%20estilos.css" text="Salir al Menú">
                     <padding>
                        <Insets bottom="6.0" left="34.0" right="34.0" top="6.0" />
                     </padding></Button>
         </items>
      </ToolBar>
   </items>
</SplitPane>
   </children>
</VBox>
