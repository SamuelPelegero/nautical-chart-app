<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="poiupv.FXMLlistapreguntasController">
   <children>
      <HBox alignment="CENTER" styleClass="menu" stylesheets="@../resources/menu%20estilos.css">
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </VBox.margin>
         <children>
            <Text fill="WHITE" styleClass="menu" text="Elegir Problema">
               <font>
                  <Font name="Arial Rounded MT Bold" size="36.0" />
               </font>
            </Text>
         </children>
      </HBox>
      <SplitPane dividerPositions="0.7" VBox.vgrow="ALWAYS">
   <items>
      <ListView fx:id="listaview" prefWidth="400.0" VBox.vgrow="ALWAYS" />
      <ToolBar orientation="VERTICAL" prefWidth="200.0">
         <items>
            <Button fx:id="elegirpre" alignment="CENTER" onAction="#handleelegirpregunta" styleClass="realiz" stylesheets="@../resources/menu%20estilos.css" text="Elegir Pregunta">
