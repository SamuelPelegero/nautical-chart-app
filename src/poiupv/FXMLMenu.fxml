<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="TOP_CENTER"
      spacing="30"
      style="-fx-background-color: white;"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="poiupv.FXMLMenuController"
      prefWidth="800" prefHeight="600"
      minWidth="700" minHeight="500">
   
   <!-- Encabezado -->
   <HBox alignment="CENTER" style="-fx-background-color: #0685BC;" HBox.hgrow="ALWAYS">
      <children>
         <Text fill="WHITE" text="Menú Principal">
            <font>
               <Font name="Arial Rounded MT Bold" size="36.0" />
            </font>
         </Text>
      </children>
      <padding>
         <Insets bottom="20" left="20" right="20" top="20" />
      </padding>
   </HBox>

   <!-- Contenedor de opciones -->
   <VBox alignment="CENTER" spacing="20" VBox.vgrow="ALWAYS">

      <!-- Realizar Problema -->
      <HBox alignment="CENTER" spacing="15" HBox.hgrow="ALWAYS">
         <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
            <image>
               <Image url="@../resources/OIP.jpg" />
            </image>
         </ImageView>
         <Button onAction="#handleRealizarProblema"
                 prefHeight="60" prefWidth="300"
                 style="-fx-background-color: #0685BC;"
                 text="Realizar Problema"
                 textFill="WHITE">
            <font>
               <Font size="18.0" />
            </font>
         </Button>
      </HBox>

      <!-- Modificar Perfil -->
      <HBox alignment="CENTER" spacing="15" HBox.hgrow="ALWAYS">
         <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
            <image>
               <Image url="@../resources/modperfil.jpg" />
            </image>
         </ImageView>
         <Button onAction="#handleModificarPerfil"
                 prefHeight="60" prefWidth="300"
                 style="-fx-background-color: #0685BC;"
                 text="Modificar Perfil"
                 textFill="WHITE">
            <font>
               <Font size="18.0" />
            </font>
         </Button>
      </HBox>

      <!-- Mostrar Resultados -->
      <HBox alignment="CENTER" spacing="15" HBox.hgrow="ALWAYS">
         <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
            <image>
               <Image url="@../resources/resultado.png" />
            </image>
         </ImageView>
         <Button onAction="#handleMostrarResultados"
                 prefHeight="60" prefWidth="300"
                 style="-fx-background-color: #0685BC;"
                 text="Mostrar Resultados"
                 textFill="WHITE">
            <font>
               <Font size="18.0" />
            </font>
         </Button>
      </HBox>

      <!-- Cerrar Sesión -->
      <HBox alignment="CENTER" spacing="15" HBox.hgrow="ALWAYS">
         <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
            <image>
               <Image url="@../resources/cerrarsesion.png" />
            </image>
         </ImageView>
         <Button onAction="#handleCerrarSesion"
                 prefHeight="60" prefWidth="300"
                 style="-fx-background-color: #d09901;"
                 text="Cerrar Sesión"
                 textFill="WHITE">
            <font>
               <Font size="18.0" />
            </font>
         </Button>
      </HBox>

   </VBox>

   <padding>
      <Insets bottom="30" left="20" right="20" top="30" />
   </padding>
</VBox>
